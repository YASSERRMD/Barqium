# Multi-stage build for the barqium data-plane binary.
# Build context: repo root.

FROM rust:1.75-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev cmake && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

RUN cargo build --release -p barqium

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/barqium /usr/local/bin/barqium
ENTRYPOINT ["/usr/local/bin/barqium"]
